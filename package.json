{
  "name": "lexi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lexi - 渐进式、沉浸式英语阅读与听说训练沙盒",
  "scripts": {
    "dev": "npm run build:extensions && vite --host 0.0.0.0",
    "build": "npm run build:wordnet && npm run build:extensions && npm run validate:course && vite build",
    "preview": "vite preview",
    "build:course": "node scripts/course-tools.mjs build",
    "validate:course": "node scripts/course-tools.mjs validate",
    "build:extensions": "node scripts/build-extension-datasets.mjs",
    "build:dict": "node scripts/build-dictionary-shards.mjs",
    "build:data": "node scripts/extract-stardict.mjs && node scripts/build-dictionary-shards.mjs",
    "validate:dicts": "node scripts/validate-dictionary-assets.mjs",
    "prepare:wordnet": "node scripts/prepare-wordnet.mjs",
    "build:wordnet": "npm run prepare:wordnet && node scripts/build-wordnet.mjs"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "csv-parse": "^5.5.0",
    "dexie": "^4.4.4",
    "marked": "^18.0.7",
    "pinia": "^4.0.2",
    "sql.js": "^1.10.0",
    "vue": "^3.5.40",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "7zip-min": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
